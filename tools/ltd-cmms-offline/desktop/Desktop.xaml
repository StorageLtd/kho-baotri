<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LTD • CMMS Desktop" Width="1440" Height="900" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#EFF3F8" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24364B"/><Setter Property="BorderBrush" Value="#D5DFEA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#136D65"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#136D65"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#C7D4E2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="12,3"/><Setter Property="Padding" Value="16,12"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#CED9E5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E8EDF3"/><Setter Property="AlternatingRowBackground" Value="#F6F9FC"/><Setter Property="RowHeight" Value="38"/><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E7EEF5"/><Setter Property="Foreground" Value="#31465D"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/></Style></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
 <Grid x:Name="Shell" Visibility="Collapsed">
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#142A40"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="20,25,12,22"><Image x:Name="Logo" Width="115" Height="54" HorizontalAlignment="Left" Stretch="Uniform"/><TextBlock Text="CMMS DESKTOP" Foreground="White" FontSize="21" FontWeight="Bold" Margin="0,14,0,4"/><TextBlock Text="LTD VIỆT NAM" Foreground="#6ED7C3" FontWeight="SemiBold" FontSize="12"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="20,14"><TextBlock Text="●  DỮ LIỆU NỘI BỘ" Foreground="#70D5BA" FontWeight="SemiBold"/><TextBlock x:Name="SideStatus" Text="Lưu trên máy tính này" Foreground="#8FA4BA" Margin="0,8,0,12" TextWrapping="Wrap"/><Button x:Name="Logout" Content="Đăng xuất" Background="#243E58" Foreground="White" BorderThickness="0" Margin="0"/></StackPanel>
   <StackPanel>
    <Button x:Name="NavOverview" Tag="overview" Content="▦   Tổng quan" Style="{StaticResource Nav}"/>
    <Button x:Name="NavInventory" Tag="inventory" Content="▣   Kho linh kiện" Style="{StaticResource Nav}"/>
    <Button x:Name="NavMachines" Tag="machines" Content="▤   Danh sách máy" Style="{StaticResource Nav}"/>
    <Button x:Name="NavJobs" Tag="jobs" Content="◷   Kế hoạch bảo trì" Style="{StaticResource Nav}"/>
    <Button x:Name="NavHistory" Tag="history" Content="▥   Lịch sử sửa chữa" Style="{StaticResource Nav}"/>
    <Button x:Name="NavCnc" Tag="cnc" Content="◉   Giám sát CNC" Style="{StaticResource Nav}"/>
    <Button x:Name="NavMovements" Tag="movements" Content="⇄   Lịch sử nhập / xuất" Style="{StaticResource Nav}"/>
    <Button x:Name="NavAccounts" Tag="accounts" Content="⚙   Tài khoản nội bộ" Style="{StaticResource Nav}"/>
   </StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="122"/><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#DEE6EF" BorderThickness="0,0,0,1" Padding="26,20"><DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="Identity" VerticalAlignment="Center" Foreground="#425A71" Margin="0,0,16,0"/><Button x:Name="Backup" Content="Sao lưu"/><Button x:Name="Restore" Content="Nhập dữ liệu"/></StackPanel>
    <StackPanel><TextBlock x:Name="PageTitle" Text="Tổng quan" FontSize="25" FontWeight="SemiBold" Foreground="#1E354B"/><TextBlock x:Name="PageSubtitle" Foreground="#6F8295" Margin="0,5,0,0"/></StackPanel>
   </DockPanel></Border>
   <UniformGrid Grid.Row="1" Columns="4" Margin="20,17,20,8">
    <Border Background="White" Margin="6,0" Padding="18,13" CornerRadius="9"><StackPanel><TextBlock x:Name="MetricLabel1" Text="LINH KIỆN" Foreground="#7890A4" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="Metric1" Foreground="#175A70" FontSize="29" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
    <Border Background="White" Margin="6,0" Padding="18,13" CornerRadius="9"><StackPanel><TextBlock x:Name="MetricLabel2" Text="THIẾT BỊ" Foreground="#7890A4" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="Metric2" Foreground="#197E69" FontSize="29" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
    <Border Background="White" Margin="6,0" Padding="18,13" CornerRadius="9"><StackPanel><TextBlock x:Name="MetricLabel3" Text="BẢO TRÌ ĐẾN HẠN" Foreground="#7890A4" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="Metric3" Foreground="#B67A15" FontSize="29" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
    <Border Background="White" Margin="6,0" Padding="18,13" CornerRadius="9"><StackPanel><TextBlock x:Name="MetricLabel4" Text="CNC KẾT NỐI" Foreground="#7890A4" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="Metric4" Foreground="#785DB3" FontSize="29" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
   </UniformGrid>
   <DockPanel Grid.Row="2" Margin="26,8,26,15">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Add" Content="＋ Thêm mới" Style="{StaticResource Primary}"/><Button x:Name="Edit" Content="Sửa"/><Button x:Name="Delete" Content="Xóa" Foreground="#B44C4C"/><Button x:Name="Stock" Content="Nhập / xuất"/><Button x:Name="Complete" Content="✓ Hoàn tất kỳ"/><Button x:Name="Details" Content="Xem chi tiết"/><Button x:Name="Export" Content="Xuất Excel"/><Button x:Name="Refresh" Content="↻" ToolTip="Làm mới"/></StackPanel>
    <StackPanel Orientation="Horizontal"><TextBlock Text="Tìm kiếm" VerticalAlignment="Center" Foreground="#60778D" Margin="0,0,10,0"/><TextBox x:Name="Search" MinWidth="170" MaxWidth="340" Margin="0,0,12,0" ToolTip="Tìm theo tên, mã, người phụ trách…" HorizontalAlignment="Left" Width="220"/></StackPanel>
   </DockPanel>
   <Grid Grid.Row="3" Margin="26,0,26,12">
    <Border Background="White" CornerRadius="9" Padding="1"><DataGrid x:Name="Records"/></Border>
    <ScrollViewer x:Name="CncScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Background="#EFF3F8"><WrapPanel x:Name="CncTiles"/></ScrollViewer>
   </Grid>
   <DockPanel Grid.Row="4" Margin="28,0,28,10"><TextBlock x:Name="Notice" Foreground="#456176"/><TextBlock x:Name="Clock" DockPanel.Dock="Right" Foreground="#7890A4" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
 </Grid>
 <Grid x:Name="LoginOverlay" Background="#E9EFF5">
  <Border Width="470" Padding="38" Background="White" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center">
   <StackPanel>
    <TextBlock Text="LTD  /  CMMS DESKTOP" Foreground="#127A68" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="LoginTitle" Text="Đăng nhập nội bộ" FontSize="29" Foreground="#1D344B" Margin="0,18,0,8" FontWeight="SemiBold"/><TextBlock x:Name="LoginHint" Text="Dữ liệu lưu trên máy tính này." Foreground="#6B8297" TextWrapping="Wrap" Margin="0,0,0,24"/>
    <TextBlock Text="Tài khoản dạng email" Margin="0,0,0,7"/><TextBox x:Name="LoginEmail" Text="admin@ltd.local" Height="38"/>
    <TextBlock Text="Mật khẩu nội bộ" Margin="0,18,0,7"/><PasswordBox x:Name="LoginPassword" Padding="10" Height="38" MaxLength="128"/>
    <TextBlock x:Name="ConfirmLabel" Text="Nhập lại mật khẩu mới" Margin="0,18,0,7" Visibility="Collapsed"/><PasswordBox x:Name="LoginConfirm" Padding="10" Height="38" MaxLength="128" Visibility="Collapsed"/>
    <TextBlock x:Name="LoginError" Foreground="#B13C3C" TextWrapping="Wrap" Margin="0,14,0,14"/><Button x:Name="LoginSubmit" Content="Đăng nhập" Style="{StaticResource Primary}" IsDefault="True"/>
   </StackPanel>
  </Border>
 </Grid>
 </Grid>
</Window>
